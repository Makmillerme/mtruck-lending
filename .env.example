# Contact form (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Expert Travel <noreply@example.com>"

# Optional: override recipient (default from lib/landing-data.ts contact.email)
# CTA_RECEIVER_EMAIL=sales@example.com

# Optional: external form endpoint instead of SMTP
# CTA_FORMSUBMIT_ENDPOINT=
