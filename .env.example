# Contact form (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Expert Travel <noreply@example.com>"

# Optional: CTA form recipient (default: contact.email in lib/landing-data.ts)
# CTA_RECEIVER_EMAIL=sales@example.com

# Optional: external form endpoint instead of SMTP
# CTA_FORMSUBMIT_ENDPOINT=

# Site reviews (JSON file data/site-reviews.json)
# REVIEWS_AUTO_APPROVE=true
# Admin panel: /admin/reviews (min. 8 characters)
REVIEWS_ADMIN_PASSWORD=change-me-to-a-strong-password
