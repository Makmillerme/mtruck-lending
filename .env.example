# Contact form (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Expert Travel <noreply@example.com>"

# Optional: private CTA form recipient(s), not shown on the site.
# Public contact email from lib/landing-data.ts is always included too.
# Separate multiple private recipients with comma or semicolon.
# CTA_RECEIVER_EMAIL=private@example.com

# Optional: external form endpoint instead of SMTP
# CTA_FORMSUBMIT_ENDPOINT=

# Site reviews (JSON file data/site-reviews.json)
# REVIEWS_AUTO_APPROVE=true
# Admin panel: /admin/reviews (min. 8 characters)
REVIEWS_ADMIN_PASSWORD=change-me-to-a-strong-password
